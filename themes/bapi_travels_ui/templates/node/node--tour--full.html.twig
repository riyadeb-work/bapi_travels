{#
/**
 * @file
 * Theme override to display a Tour node.
 */
#}
{% set category_name = node.field_tour_category.entity.name.value %}
{% set is_upcoming = category_name|lower == 'upcoming' %}

{% include directory ~ '/templates/includes/header.html.twig' %}

{# The article wrapper and title prefix/suffix are required for Drupal's contextual edit links (the pencil icon) to work #}
<article{{ attributes }}>
  {{ title_prefix }}
  {{ title_suffix }}

  <main id="main-content" class="pt-20">
    <div class="w-full h-[40vh] md:h-[60vh] relative">

      {# Updated to handle Drupal core Media entities #}
      {% set media_uri = node.field_banner_image.entity.field_media_image.entity.uri.value %}
      {% if media_uri %}
        <img src="{{ file_url(media_uri) }}" alt="{{ label }}" class="w-full h-full object-cover">
      {% endif %}

      <div class="absolute inset-0 bg-gradient-to-t from-secondary/80 to-transparent"></div>
      <div class="absolute top-8 left-4 z-10">
        <a href="javascript:history.back()" class="bg-white/80 backdrop-blur px-4 py-2 rounded-lg text-secondary hover:text-primary font-medium flex items-center gap-2 shadow-md">
          <i class="fa-solid fa-arrow-left"></i> Back to Tours
        </a>
      </div>
      <div class="absolute bottom-0 left-0 w-full p-6 md:p-12">
        <div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-end">
          <div class="text-white">
            <span class="bg-primary text-secondary text-xs font-bold px-3 py-1 rounded-full uppercase mb-4 inline-block">
              {{ category_name }}
            </span>
            <h1 class="text-3xl md:text-5xl font-bold mb-2">{{ label }}</h1>
            <p class="text-lg text-gray-200">
              <i class="fa-solid fa-location-dot text-primary mr-2"></i> {{ node.field_location.value }}
            </p>
          </div>
        </div>
      </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 py-12 flex flex-col lg:flex-row gap-10 relative">

      <div class="w-full lg:w-2/3">

        <div class="bg-white rounded-xl shadow-sm p-6 flex flex-wrap gap-8 mb-8 border border-gray-100">
          <div>
            <div class="text-sm text-gray-500 mb-1">Duration</div>
            <div class="font-bold text-lg"><i class="fa-regular fa-clock text-primary mr-1"></i> {{ node.field_duration.value }}</div>
          </div>
          <div>
            <div class="text-sm text-gray-500 mb-1">Tour Type</div>
            <div class="font-bold text-lg"><i class="fa-solid fa-users text-primary mr-1"></i> {{ node.field_tour_type.entity.name.value }}</div>
          </div>
          <div>
            <div class="text-sm text-gray-500 mb-1">Season</div>
            <div class="font-bold text-lg"><i class="fa-solid fa-sun text-primary mr-1"></i> {{ node.field_season.value }}</div>
          </div>
        </div>

        {# CONDITIONAL: Upcoming Tour Specific Info Bar #}
        {% if is_upcoming %}
          <div class="bg-primary/10 rounded-xl p-6 flex flex-wrap gap-8 mb-8 border border-primary/20">
            {% if node.field_group_size.value %}
              <div>
                <div class="text-sm text-gray-600 mb-1">Group Size</div>
                <div class="font-bold text-lg"><i class="fa-solid fa-user-group text-primary mr-1"></i> {{ node.field_group_size.value }} People</div>
              </div>
            {% endif %}
            {% if node.field_source.value and node.field_destination.value %}
              <div class="w-full">
                <div class="text-sm text-gray-600 mb-1">Route</div>
                <div class="font-bold text-lg"><i class="fa-solid fa-route text-primary mr-1"></i> {{ node.field_source.value }} to {{ node.field_destination.value }}</div>
              </div>
            {% endif %}
          </div>
        {% endif %}

        <div class="mb-12 prose max-w-none text-gray-600">
          <h2 class="text-2xl font-bold mb-4 text-gray-900">Tour Overview</h2>
          {{ content.body }}
        </div>

        <div>
          <h2 class="text-2xl font-bold mb-6">Day-wise Itinerary</h2>
          <div class="space-y-6">
            {% for item in node.field_itinerary %}
              {% set paragraph = item.entity %}
              {% set is_last = loop.last %}

              <div class="border-l-2 {{ is_last ? 'border-gray-200' : 'border-primary' }} pl-6 pb-2 relative">
                <div class="absolute w-4 h-4 {{ is_last ? 'bg-gray-300' : 'bg-primary' }} rounded-full -left-[9px] top-1"></div>
                <h3 class="text-xl font-bold">{{ paragraph.field_day_title.value }}</h3>
                <div class="text-gray-600 mt-2 prose-sm">
                  {{ paragraph.field_day_description.value|raw }}
                </div>
              </div>
            {% endfor %}
          </div>
        </div>

      </div>

      <div class="w-full lg:w-1/3">
        <div class="bg-white rounded-2xl shadow-lg p-6 sticky top-24 border border-gray-100">
          <div class="mb-6 pb-6 border-b border-gray-100">
            <h3 class="text-2xl font-bold text-secondary mb-2">Interested?</h3>
            <p class="text-gray-500 text-sm">Packages are customizable based on your preferences and group size.</p>
          </div>

          <ul class="space-y-4 mb-8 text-sm text-gray-600">
            {% for inclusion in node.field_inclusions %}
              <li class="flex items-start gap-3">
                <i class="fa-solid fa-check text-green-500 mt-1"></i>
                {{ inclusion.entity.name.value }}
              </li>
            {% endfor %}
          </ul>

          <button id="book-btn" class="wa-book-btn w-full bg-[#25D366] text-white py-4 rounded-xl font-bold text-lg hover:bg-green-600 transition flex items-center justify-center gap-2 shadow-md" data-tour="{{ label }}" data-cat="{{ category_name }}">
            <i class="fa-brands fa-whatsapp text-2xl"></i> Enquire & Book via WhatsApp
          </button>
          <p class="text-center text-xs text-gray-400 mt-4">We usually reply within 15 minutes.</p>
        </div>
      </div>
    </div>
  </main>
</article>

{% include directory ~ '/templates/includes/footer.html.twig' %}
