{#
/**
 * @file
 * Custom theme implementation for the basic structure of a single Drupal page.
 */
#}
<!DOCTYPE html>
<html{{ html_attributes.addClass('scroll-smooth') }}>
<head>
  <head-placeholder token="{{ placeholder_token }}">
    <title>{{ head_title|safe_join(' | ') }}</title>
    <css-placeholder token="{{ placeholder_token }}">
      <js-placeholder token="{{ placeholder_token }}">

        <!-- Tailwind, Fonts, and Icons from static HTML -->
        <script src="https://cdn.tailwindcss.com"></script>
        <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet" />
        <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

        <!-- Tailwind Config -->
        <script>
          tailwind.config = {
            theme: {
              extend: {
                colors: {
                  primary: "#EAB308", // Yellow
                  secondary: "#0F172A", // Deep Slate
                },
                fontFamily: { sans: ["Poppins", "sans-serif"] },
              },
            },
          };
        </script>
        </head>
<body{{ attributes.addClass('font-sans', 'bg-gray-50', 'text-secondary', 'antialiased') }}>
{# The visually hidden skip link is good for accessibility #}
<a href="#main-content" class="visually-hidden focusable skip-link">
  {{ 'Skip to main content'|t }}
</a>

{# page_top renders the Admin Toolbar for logged-in users #}
{{ page_top }}

{# page renders your actual page templates (like page--front.html.twig) #}
{{ page }}

{# page_bottom renders final scripts #}
{{ page_bottom }}
<js-bottom-placeholder token="{{ placeholder_token }}">
</body>
</html>
