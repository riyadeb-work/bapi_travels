{% include directory ~ '/templates/includes/header.html.twig' %}

<main id="main-content">
  <!-- Hero Section -->
  <section class="hero-bg h-screen flex items-center justify-center text-center pt-20">
    <div class="max-w-4xl px-4">
      <h1 class="text-4xl md:text-6xl font-bold text-white mb-6 leading-tight">
        Explore <span class="text-primary">The World</span> With <span class="text-primary">Bapi Travels</span>
      </h1>
      <p class="text-lg md:text-xl text-gray-200 mb-10">
        Your trusted partner for customized national, international, and adventure experiences.
      </p>
      <a href="#tours-section" class="inline-block bg-primary text-secondary px-8 py-4 rounded-full font-bold text-lg hover:bg-yellow-400 transition transform hover:-translate-y-1 shadow-lg">
        Explore Now <i class="fa-solid fa-arrow-down ml-2"></i>
      </a>
    </div>
  </section>

