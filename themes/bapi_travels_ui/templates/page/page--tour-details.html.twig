{% include directory ~ '/templates/includes/header.html.twig' %}

<main id="main-content" class="pt-20">
  <!-- Banner Image -->
  <div class="w-full h-[40vh] md:h-[60vh] relative">
    <img src="https://images.unsplash.com/photo-1537996194471-e657df975ab4?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80" alt="Bali" class="w-full h-full object-cover">
    <div class="absolute inset-0 bg-gradient-to-t from-secondary/80 to-transparent"></div>
    <div class="absolute top-4 left-4 z-10">
      <a href="javascript:history.back()" class="bg-white/80 backdrop-blur px-4 py-2 rounded-lg text-secondary hover:text-primary font-medium flex items-center gap-2 shadow-md">
        <i class="fa-solid fa-arrow-left"></i> Back to Tours
      </a>
    </div>
    <div class="absolute bottom-0 left-0 w-full p-6 md:p-12">
      <div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-end">
        <div class="text-white">
          <span class="bg-primary text-secondary text-xs font-bold px-3 py-1 rounded-full uppercase mb-4 inline-block">International</span>
          <h1 class="text-3xl md:text-5xl font-bold mb-2">Bali Tropical Escape</h1>
          <p class="text-lg text-gray-200"><i class="fa-solid fa-location-dot text-primary mr-2"></i> Bali, Indonesia</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Content Grid -->
  <div class="max-w-7xl mx-auto px-4 py-12 flex flex-col lg:flex-row gap-10 relative">

    <!-- Left Column: Details -->
    <div class="w-full lg:w-2/3">

      <!-- Key Info Bar -->
      <div class="bg-white rounded-xl shadow-sm p-6 flex flex-wrap gap-8 mb-8 border border-gray-100">
        <div>
          <div class="text-sm text-gray-500 mb-1">Duration</div>
          <div class="font-bold text-lg"><i class="fa-regular fa-clock text-primary mr-1"></i> 7 Days / 6 Nights</div>
        </div>
        <div>
          <div class="text-sm text-gray-500 mb-1">Tour Type</div>
          <div class="font-bold text-lg"><i class="fa-solid fa-users text-primary mr-1"></i> Family & Couple</div>
        </div>
        <div>
          <div class="text-sm text-gray-500 mb-1">Season</div>
          <div class="font-bold text-lg"><i class="fa-solid fa-sun text-primary mr-1"></i> All Year Round</div>
        </div>
      </div>

      <!-- Overview -->
      <div class="mb-12">
        <h2 class="text-2xl font-bold mb-4">Tour Overview</h2>
        <p class="text-gray-600 leading-relaxed mb-4">
          Experience the magic of Bali in this comprehensive 7-day tour. From the spiritual heart of Ubud to the stunning beaches of Nusa Dua, this package offers a perfect blend of culture, relaxation, and adventure.
        </p>
        <p class="text-gray-600 leading-relaxed">
          You'll visit iconic temples, witness traditional Barong dances, explore lush rice terraces, and have plenty of leisure time to enjoy the crystal clear waters. Ideal for couples seeking a romantic getaway or families looking for diverse activities.
        </p>
      </div>

      <!-- Itinerary -->
      <div>
        <h2 class="text-2xl font-bold mb-6">Day-wise Itinerary</h2>

        <div class="space-y-6">
          <!-- Day 1 -->
          <div class="border-l-2 border-primary pl-6 pb-2 relative">
            <div class="absolute w-4 h-4 bg-primary rounded-full -left-[9px] top-1"></div>
            <h3 class="text-xl font-bold">Day 1: Arrival in Bali & Check-in</h3>
            <p class="text-gray-600 mt-2">Welcome to Bali! Our representative will meet you at the Ngurah Rai International Airport and transfer you to your hotel in Kuta/Seminyak. Spend the rest of the day relaxing and exploring the local area at your own pace.</p>
          </div>
          <!-- Day 2 -->
          <div class="border-l-2 border-primary pl-6 pb-2 relative">
            <div class="absolute w-4 h-4 bg-primary rounded-full -left-[9px] top-1"></div>
            <h3 class="text-xl font-bold">Day 2: Full Day Kintamani & Ubud Tour</h3>
            <p class="text-gray-600 mt-2">After breakfast, proceed for a full-day tour. Visit the Celuk village (famous for silver crafting), admire the breathtaking Mount Batur volcano at Kintamani, and explore the iconic Tegalalang Rice Terraces in Ubud.</p>
          </div>
          <!-- Day 3 -->
          <div class="border-l-2 border-primary pl-6 pb-2 relative">
            <div class="absolute w-4 h-4 bg-primary rounded-full -left-[9px] top-1"></div>
            <h3 class="text-xl font-bold">Day 3: Water Sports & Uluwatu Sunset Temple</h3>
            <p class="text-gray-600 mt-2">Head to Tanjung Benoa beach for thrilling water sports (Banana Boat ride included). Later in the afternoon, visit the magnificent Uluwatu Temple perched on a cliff, followed by a traditional Kecak Fire Dance performance at sunset.</p>
          </div>
          <!-- Day 4 -->
          <div class="border-l-2 border-primary pl-6 pb-2 relative">
            <div class="absolute w-4 h-4 bg-primary rounded-full -left-[9px] top-1"></div>
            <h3 class="text-xl font-bold">Day 4: Nusa Penida Island Day Trip</h3>
            <p class="text-gray-600 mt-2">Take a fast boat to Nusa Penida. Visit the famous Kelingking Beach, Broken Beach, and Angel's Billabong. Enjoy snorkeling in crystal clear waters before returning to mainland Bali.</p>
          </div>
          <!-- Day 5 -->
          <div class="border-l-2 border-gray-200 pl-6 pb-2 relative">
            <div class="absolute w-4 h-4 bg-gray-300 rounded-full -left-[9px] top-1"></div>
            <h3 class="text-xl font-bold">Day 5: Leisure & Departure</h3>
            <p class="text-gray-600 mt-2">Enjoy your breakfast. You have free time for last-minute shopping before being transferred to the airport for your onward journey with beautiful memories.</p>
          </div>
        </div>
      </div>

    </div>

    <!-- Right Column: Sticky Booking Card -->
    <div class="w-full lg:w-1/3">
      <div class="bg-white rounded-2xl shadow-lg p-6 sticky top-24 border border-gray-100">
        <div class="mb-6 pb-6 border-b border-gray-100">
          <h3 class="text-2xl font-bold text-secondary mb-2">Interested?</h3>
          <p class="text-gray-500 text-sm">Packages are customizable based on your preferences and group size.</p>
        </div>

        <ul class="space-y-4 mb-8 text-sm text-gray-600">
          <li class="flex items-start gap-3"><i class="fa-solid fa-check text-green-500 mt-1"></i> Hotel Accommodation</li>
          <li class="flex items-start gap-3"><i class="fa-solid fa-check text-green-500 mt-1"></i> Daily Breakfast</li>
          <li class="flex items-start gap-3"><i class="fa-solid fa-check text-green-500 mt-1"></i> Airport Transfers</li>
          <li class="flex items-start gap-3"><i class="fa-solid fa-check text-green-500 mt-1"></i> Sightseeing as per Itinerary</li>
        </ul>

        {# Note: we added the 'wa-book-btn' class and data attributes so the global script handles it automatically #}
        <button id="book-btn" class="wa-book-btn w-full bg-[#25D366] text-white py-4 rounded-xl font-bold text-lg hover:bg-green-600 transition flex items-center justify-center gap-2 shadow-md" data-tour="Bali Tropical Escape" data-cat="International">
          <i class="fa-brands fa-whatsapp text-2xl"></i> Enquire & Book via WhatsApp
        </button>
        <p class="text-center text-xs text-gray-400 mt-4">We usually reply within 15 minutes.</p>
      </div>
    </div>
  </div>
</main>

{% include directory ~ '/templates/includes/footer.html.twig' %}
<div class="hidden">{{ page.content }}</div>
