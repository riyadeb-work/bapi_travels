{% include directory ~ '/templates/includes/header.html.twig' %}

<main id="main-content" class="pt-20">
  <!-- Header -->
  <div class="bg-primary text-secondary py-12 text-center">
    <h1 class="text-4xl font-bold mb-2">Upcoming Group Departures</h1>
    <p class="font-medium opacity-80">Join our fixed departure dates and travel with a fun group!</p>
  </div>

  <!-- Main Content -->
  <div class="max-w-7xl mx-auto px-4 py-16 space-y-16">

    <!-- January Section -->
    <div>
      <div class="flex items-center gap-4 mb-8">
        <h2 class="text-3xl font-bold">January 2027</h2>
        <div class="h-[1px] bg-gray-300 flex-grow"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Card -->
        <div class="bg-white rounded-xl shadow-md overflow-hidden relative border border-gray-100">
          <div class="h-48 overflow-hidden relative">
            <img src="https://images.unsplash.com/photo-1512343879784-a960bf40e7f2?w=600" class="w-full h-full object-cover" alt="Goa">
            <div class="absolute bottom-0 w-full bg-black/60 text-white p-2 text-center font-bold tracking-widest text-sm uppercase">12th Jan Departure</div>
          </div>
          <div class="p-5">
            <h3 class="text-xl font-bold mb-2">Goa Carnival Special</h3>
            <p class="text-gray-500 text-sm mb-4">4 Days / 3 Nights</p>
            <a href="/tour-details" class="block w-full text-center border-2 border-secondary text-secondary py-2 rounded font-bold hover:bg-secondary hover:text-white transition">View Itinerary</a>
          </div>
        </div>
      </div>
    </div>

    <!-- February Section -->
    <div>
      <div class="flex items-center gap-4 mb-8">
        <h2 class="text-3xl font-bold">February 2027</h2>
        <div class="h-[1px] bg-gray-300 flex-grow"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Card -->
        <div class="bg-white rounded-xl shadow-md overflow-hidden relative border border-gray-100">
          <div class="h-48 overflow-hidden relative">
            <img src="https://images.unsplash.com/photo-1548013146-72479768bada?w=600" class="w-full h-full object-cover" alt="Agra">
            <div class="absolute bottom-0 w-full bg-black/60 text-white p-2 text-center font-bold tracking-widest text-sm uppercase">10th Feb Departure</div>
          </div>
          <div class="p-5">
            <h3 class="text-xl font-bold mb-2">Golden Triangle</h3>
            <p class="text-gray-500 text-sm mb-4">5 Days / 4 Nights</p>
            <a href="/tour-details" class="block w-full text-center border-2 border-secondary text-secondary py-2 rounded font-bold hover:bg-secondary hover:text-white transition">View Itinerary</a>
          </div>
        </div>

        <!-- Card -->
        <div class="bg-white rounded-xl shadow-md overflow-hidden relative border border-gray-100">
          <div class="h-48 overflow-hidden relative">
            <img src="https://images.unsplash.com/photo-1522083111335-ee178000f074?w=600" class="w-full h-full object-cover" alt="Swiss">
            <div class="absolute bottom-0 w-full bg-black/60 text-white p-2 text-center font-bold tracking-widest text-sm uppercase">25th Feb Departure</div>
          </div>
          <div class="p-5">
            <h3 class="text-xl font-bold mb-2">Swiss Alps Escapade</h3>
            <p class="text-gray-500 text-sm mb-4">8 Days / 7 Nights</p>
            <a href="/tour-details" class="block w-full text-center border-2 border-secondary text-secondary py-2 rounded font-bold hover:bg-secondary hover:text-white transition">View Itinerary</a>
          </div>
        </div>
      </div>
    </div>

  </div>
</main>

{% include directory ~ '/templates/includes/footer.html.twig' %}
<div class="hidden">{{ page.content }}</div>
