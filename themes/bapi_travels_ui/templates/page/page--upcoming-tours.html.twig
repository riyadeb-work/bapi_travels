{#
/**
 * @file
 * Page template for /upcoming-tours.
 * Drupal names page templates after the URL path, e.g. a path of
 * "upcoming-tours" maps to page--upcoming-tours.html.twig automatically —
 * no extra routing needed. Adjust if your alias differs.
 */
#}

{% include directory ~ '/templates/includes/header.html.twig' %}

<main id="main-content">

  {# --- Hero banner, matches the yellow band in the reference UI --- #}
  <section class="bg-primary py-14 md:py-16 text-center px-4">
    <h1 class="text-3xl md:text-4xl font-bold text-secondary mb-3">
      Upcoming Group Departures
    </h1>
    <p class="text-secondary/80 text-base md:text-lg">
      Join our fixed departure dates and travel with a fun group!
    </p>
  </section>

  {# --- The grouped tour listing (rendered by the View) ------------- #}
    <section class="bg-gray-50">
      {# Changed py-12 md:py-16 to explicit pt and pb classes #}
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-12 md:pt-8 md:pb-16">
        {{ page.content }}
      </div>
    </section>

</main>

{% include directory ~ '/templates/includes/footer.html.twig' %}
