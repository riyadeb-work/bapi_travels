{#
/**
 * @file
 * Theme override for the grouped upcoming tours.
 * Drupal automatically passes the group header (e.g., "September") into `title`.
 *
 * Changed from a 3-column grid to a centered single-column stack: with
 * usually just 1 (rarely 2) departures per month, a grid left most of the
 * row empty. A max-width column of full-width horizontal cards reads as
 * intentional regardless of how many items there are.
 */
#}
<div class="mb-12 md:mb-16 last:mb-0">
  {% if title %}
    <div class="flex items-center gap-4 mb-6 max-w-3xl mx-auto">
      <h2 class="text-2xl md:text-3xl font-bold text-secondary whitespace-nowrap">
        {# Add striptags and trim to remove the huge whitespace gaps #}
        {{ title|striptags|trim }}
      </h2>
      <div class="flex-1 h-px bg-gray-200"></div>
    </div>
  {% endif %}

  {# --- Centered stack of full-width horizontal cards for this month --- #}
  <div class="max-w-3xl mx-auto space-y-6">
    {% for row in rows %}
      <div{{ row.attributes }}>
        {{ row.content }}
      </div>
    {% endfor %}
  </div>
</div>
