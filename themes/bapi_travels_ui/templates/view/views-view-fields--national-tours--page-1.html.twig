{#
/**
 * @file
 * Single tour card for /national-tours (view: national_tours, display: page_1).
 *
 * Field handler keys used:
 *   fields.field_media_image  - the image URL as plain text (via the
 *                               field_banner_image -> Media relationship,
 *                               formatter: "Image URL"). Because this
 *                               formatter outputs a raw URL string rather
 *                               than an <img> tag, the template builds the
 *                               <img> itself below.
 *
 *                               Tip: set an Image style on this field in
 *                               Views UI (currently blank) so a properly
 *                               sized/cropped version is served instead of
 *                               the original upload.
 *   fields.title               - tour title
 *   fields.field_body          - trimmed body/summary (optional)
 *   fields.field_duration      - e.g. "6 Days / 5 Nights" (optional)
 *
 * The "View" link is built directly from the row's node entity via
 * url(), so it works with no extra "Link to content" field required.
 *
 * No category badge — removed per request.
 */
#}
<div class="bg-white rounded-2xl overflow-hidden shadow-md group border-b-4 border-transparent hover:border-primary transition duration-300 h-full flex flex-col">

  {# --- Image ---------------------------------------------------- #}
  <div class="relative h-56 overflow-hidden bg-gray-100">
    {% set image_url = fields.field_media_image.content|render|striptags|trim %}
    {% if image_url %}
      <img src="{{ image_url }}" alt="{{ fields.title.content|render|striptags|trim }}" class="w-full h-full object-cover group-hover:scale-110 transition duration-500" />
    {% else %}
      <div class="w-full h-full flex items-center justify-center text-gray-400">
        <i class="fa-regular fa-image text-3xl"></i>
      </div>
    {% endif %}
  </div>

  {# --- Body ----------------------------------------------------------- #}
  <div class="p-6 flex flex-col flex-1">
    <h3 class="text-xl font-bold mb-2 text-secondary group-hover:text-primary transition">
      {{ fields.title.content }}
    </h3>

    {% if fields.field_body.content %}
      <div class="text-gray-600 text-sm mb-6 line-clamp-2">
        {{ fields.field_body.content }}
      </div>
    {% endif %}

    <div class="mt-auto flex justify-between items-center pt-2">
      {% if fields.field_duration.content %}
        <span class="flex items-center gap-1.5 text-sm text-gray-500">
          <i class="fa-regular fa-clock text-primary"></i>
          {{ fields.field_duration.content }}
        </span>
      {% else %}
        <span></span>
      {% endif %}

      <a href="{{ url('entity.node.canonical', {'node': row._entity.id()}) }}" class="text-secondary font-bold hover:text-primary transition inline-flex items-center gap-1">
        View <i class="fa-solid fa-arrow-right text-xs"></i>
      </a>
    </div>
  </div>
</div>
