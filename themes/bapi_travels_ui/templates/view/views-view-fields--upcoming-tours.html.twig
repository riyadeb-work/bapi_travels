{#
/**
 * @file
 * Single "Upcoming Tour" card — horizontal/featured layout.
 *
 * Field handler keys (from the view config) available as `fields.<name>`:
 *   fields.field_banner_image      - rendered image
 *   fields.title                   - tour title
 *   fields.field_journey_date      - formatted date, e.g. "12th Jan"
 *   fields.field_duration          - e.g. "4 Days / 3 Nights"
 *   fields.nid                     - link to the tour detail page (excluded field,
 *                                    read via fields.nid.content or row.nid)
 *
 * Redesigned as a wide image-left / content-right card (stacks on mobile)
 * instead of a narrow vertical card, since this view usually shows only
 * 1–2 items per month and a small card looked lost in empty space.
 */
#}
<div class="bg-white rounded-2xl overflow-hidden shadow-lg group border-b-4 border-transparent hover:border-primary transition duration-300 flex flex-col md:flex-row">

  {# --- Image with date badge overlay -------------------------------- #}
  <div class="relative h-56 md:h-auto md:w-2/5 overflow-hidden bg-gray-100 shrink-0">
    {% if fields.field_banner_image.content %}
      <div class="w-full h-full [&_img]:w-full [&_img]:h-full [&_img]:object-cover group-hover:[&_img]:scale-110 [&_img]:transition [&_img]:duration-500">
        {{ fields.field_banner_image.content }}
      </div>
    {% else %}
      <div class="w-full h-full flex items-center justify-center text-gray-400">
        <i class="fa-regular fa-image text-3xl"></i>
      </div>
    {% endif %}

    {% if fields.field_journey_date.content %}
      <div class="absolute top-4 left-4 bg-primary text-secondary text-xs md:text-sm font-bold uppercase tracking-wide text-center px-4 py-2 rounded-full shadow">
        {{ fields.field_journey_date.content }} Departure
      </div>
    {% endif %}
  </div>

  {# --- Body ----------------------------------------------------------- #}
  <div class="p-6 md:p-8 flex flex-col flex-1 justify-center">
    <h3 class="text-2xl md:text-3xl font-bold text-secondary mb-2 group-hover:text-primary transition">
      {{ fields.title.content }}
    </h3>

    {% if fields.field_duration.content %}
      <p class="flex items-center gap-2 text-gray-500 mb-6">
        <i class="fa-regular fa-clock text-primary"></i>
        {{ fields.field_duration.content }}
      </p>
    {% endif %}

    <a href="{{ url('entity.node.canonical', {'node': row._entity.id()}) }}"
           class="self-start inline-block text-center border border-secondary text-secondary font-semibold rounded-lg px-6 py-3 hover:bg-primary hover:border-primary hover:text-secondary transition">
          View Itinerary
        </a>
  </div>
</div>
